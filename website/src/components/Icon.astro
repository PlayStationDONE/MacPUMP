---
import type { IconName } from '../data/content';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

// Line icons on a 24 px grid, 1.6 px strokes, drawn to sit beside SF Symbols-style text.
const paths: Record<IconName, string> = {
  flow: 'M3 7h5c3 0 4 3 7 3h6M3 17h5c3 0 4-3 7-3h6M3 5v4M3 15v4M21 8v8',
  clock: 'M12 7v5l3 2M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
  apps: 'M4 5h7v6H4zM13 5h7v3h-7zM13 10h7v9h-7zM4 13h7v6H4z',
  chart: 'M4 4v16h16M8 15l3-4 3 2 5-6',
  badge: 'M12 3 4.5 6v5.5c0 4.2 3.1 8.2 7.5 9.5 4.4-1.3 7.5-5.3 7.5-9.5V6L12 3ZM8.8 12.2l2.2 2.2 4.4-4.6',
  lock: 'M7 10.5V8a5 5 0 0 1 10 0v2.5M5.5 10.5h13v10h-13zM12 14.5v2',
};
---

<svg
  class={className}
  viewBox="0 0 24 24"
  width="24"
  height="24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
