---
import Icon from './Icon.astro';
import { overview } from '../data/content';
---

<section class="section overview" id="features" aria-labelledby="features-title">
  <div class="container">
    <div class="section-head section-head--center" data-reveal>
      <p class="eyebrow">Features</p>
      <h2 class="h2" id="features-title">Everything your Mac’s power is doing, in plain English.</h2>
      <p class="lead">
        MacPUMP reads your adapter, battery and chip, then shows where the power is going. Start with the essentials in
        Lite mode, or switch to Advanced for the full picture.
      </p>
    </div>

    <ul class="overview__grid">
      {
        overview.map((f, i) => (
          <li class="overview__item" data-reveal style={`--reveal-delay:${(i % 3) * 70}ms`}>
            <span class="overview__icon">
              <Icon name={f.icon} />
            </span>
            <h3 class="h3">{f.title}</h3>
            <p class="muted">{f.text}</p>
            <a class="link-arrow overview__link" href={f.href}>
              <span class="visually-hidden">More about {f.title.toLowerCase()}: </span>Learn more
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .overview__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--s-7) clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .overview__item {
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding-top: var(--s-5);
    border-top: 1px solid var(--border);
  }

  .overview__icon {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: var(--s-2);
    border-radius: var(--r-sm);
    background: var(--accent-soft);
    color: var(--accent-text);
  }

  .overview__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .overview__item p {
    font-size: var(--fs-small);
    flex: 1;
  }

  .overview__link {
    margin-top: var(--s-2);
    font-size: var(--fs-small);
  }

  @media (max-width: 900px) {
    .overview__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .overview__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }

    .overview__item {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: var(--s-4);
      row-gap: var(--s-1);
    }

    .overview__icon {
      grid-row: span 3;
      margin-bottom: 0;
    }
  }
</style>
