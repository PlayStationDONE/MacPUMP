---
import { Image } from 'astro:assets';
import icon from '../assets/app-icon.png';
import popover from '../assets/screens/app-popover.png';
import { app, release, requirements } from '../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <Image
        src={icon}
        alt="MacPUMP app icon"
        width={88}
        height={88}
        widths={[88, 176]}
        sizes="88px"
        loading="eager"
        fetchpriority="high"
        class="hero__icon"
      />
      <p class="eyebrow hero__eyebrow">{app.longName}</p>
      <h1 id="hero-title" class="hero__title">See where your Mac’s power goes.</h1>
      <p class="lead hero__lead">
        A menu bar app that shows, live and in plain English, how much power your Mac is using, how long the battery
        will last, and which apps are using it. Everything stays on your Mac.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="#download">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"
            ><path
              d="M10 3v10m0 0-4-4m4 4 4-4M4 16h12"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          >
          {release.downloadUrl ? `Download ${app.name}` : `Get ${app.name}`}
        </a>
        <a class="btn btn--secondary btn--lg" href="#features">Explore features</a>
      </div>
      <ul class="hero__meta caption" aria-label="At a glance">
        <li>
          Version {release.version}{release.channel === 'pre-release' ? ' pre-release' : ''}
        </li>
        <li>{requirements.macOS.replace(' Sonoma', '')}</li>
        <li>Apple silicon</li>
        <li>No telemetry</li>
      </ul>
    </div>

    <figure class="hero__showcase">
      <div class="hero__desktop" aria-hidden="true"></div>
      <Image
        src={popover}
        alt="The MacPUMP menu bar popover while charging: a blue battery bar showing 100 percent with a marker at 76 percent, a power-flow diagram with 19.6 watts from the adapter feeding 13.8 watts to the Mac and 5.8 watts into the battery, 7 hours 20 minutes left if unplugged, and a list of app power led by Safari at 0.2 watts."
        widths={[360, 540, 732]}
        sizes="(max-width: 860px) min(86vw, 380px), 400px"
        loading="eager"
        class="hero__shot"
      />
      <figcaption class="caption hero__caption">The menu bar popover, in MacPUMP {release.version}.</figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(3rem, 2rem + 4vw, 6rem));
    padding-bottom: var(--section-y);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  .hero__icon {
    width: 88px;
    height: 88px;
    margin: 0 0 var(--s-5) -8px;
    filter: drop-shadow(0 10px 18px rgb(13 22 48 / 0.25));
  }

  .hero__eyebrow {
    color: var(--text-2);
    font-weight: 600;
  }

  .hero__title {
    font-size: var(--fs-hero);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-display);
  }

  .hero__lead {
    margin-top: var(--s-5);
    max-width: 34rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-5);
    margin: var(--s-5) 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-3);
  }

  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }

  .hero__meta li::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--energy);
  }

  /* Showcase: the real popover, as it appears under the menu bar */

  .hero__showcase {
    position: relative;
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }

  .hero__desktop {
    position: absolute;
    inset: -12% -20% -8%;
    z-index: -1;
    background:
      radial-gradient(48% 42% at 58% 40%, color-mix(in srgb, var(--accent) 16%, transparent), transparent 70%),
      radial-gradient(30% 30% at 30% 70%, color-mix(in srgb, var(--brand-cyan) 10%, transparent), transparent 70%);
    pointer-events: none;
  }

  .hero__shot {
    width: min(100%, 400px);
    height: auto;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.28)) drop-shadow(0 6px 12px rgb(0 0 0 / 0.18));
    animation: popover-in 700ms var(--ease-out) 120ms both;
    transform-origin: 50% 0;
  }

  .hero__caption {
    text-align: center;
  }

  @keyframes popover-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }

  @media (max-width: 860px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero__copy {
      text-align: center;
      display: grid;
      justify-items: center;
    }

    .hero__icon {
      margin-left: 0;
    }

    .hero__actions,
    .hero__meta {
      justify-content: center;
    }

    .hero__showcase {
      margin-top: var(--s-4);
    }
  }

  @media (max-width: 420px) {
    .hero__actions {
      width: 100%;
      flex-direction: column;
    }

    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
