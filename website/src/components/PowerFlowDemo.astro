---
import { Image } from 'astro:assets';
import { demoStates } from '../data/content';
import heavy from '../assets/screens/state-heavy-load.png';
import charging from '../assets/screens/state-charging.png';
import onBattery from '../assets/screens/state-on-battery.png';
import full from '../assets/screens/state-fully-charged.png';

// Real renders of the app's popover for each situation (MacPUMP --render --state), not drawings.
const shots = { heavy, charging, battery: onBattery, full } as const;
const initial = demoStates[0];
---

<div class="demo" data-demo data-states={JSON.stringify(demoStates)}>
  <div class="demo__controls">
    <div class="segmented glass demo__segmented" role="group" aria-label="Choose a sample situation">
      {
        demoStates.map((s, i) => (
          <button type="button" data-state={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
            {s.label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="demo__panel">
    <div class="demo__tag">
      <span class="badge badge--demo">Sample values, not a live reading</span>
    </div>

    <div class="demo__shots">
      {
        demoStates.map((s, i) => (
          <Image
            src={shots[s.id]}
            alt={`MacPUMP popover for the sample situation: ${s.title}.`}
            width={680}
            class="demo__shot"
            data-shot={s.id}
            hidden={i !== 0}
            loading={i === 0 ? 'eager' : 'lazy'}
            widths={[340, 680]}
            sizes="(min-width: 520px) 340px, 90vw"
          />
        ))
      }
    </div>
  </div>

  <div class="demo__explain" aria-live="polite">
    <p class="demo__title" data-title>{initial.title}</p>
    <p class="caption demo__note" data-note>{initial.note}</p>
  </div>
</div>

<style>
  .demo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-4);
    justify-items: center;
  }

  .demo__controls {
    max-width: 100%;
  }

  .demo__segmented {
    box-shadow: var(--glass-highlight), var(--shadow-1);
  }

  /* Four choices don't fit in one row on a phone: show them as a 2 × 2 grid instead of scrolling. */
  @media (max-width: 520px) {
    .demo__controls {
      width: min(100%, 400px);
    }

    .demo__segmented {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      border-radius: var(--r-lg);
    }

    .demo__segmented button {
      padding: 0 0.5rem;
      border-radius: calc(var(--r-lg) - 3px);
    }
  }

  .demo__panel {
    display: grid;
    gap: 12px;
    justify-items: center;
    width: min(100%, 340px);
  }

  .demo__shots {
    width: 100%;
    border-radius: 22px;
    overflow: hidden;
    background: var(--charcoal);
    box-shadow: var(--shadow-window);
  }

  .demo__shot {
    display: block;
    width: 100%;
    height: auto;
  }

  .demo__shot[hidden] {
    display: none;
  }

  .demo__explain {
    width: min(100%, 400px);
    text-align: center;
  }

  .demo__title {
    font-size: 1.0625rem;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .demo__note {
    margin-top: var(--s-1);
    text-wrap: balance;
  }
</style>

<script>
  type DemoState = { id: string; title: string; note: string };

  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) {
    const states = JSON.parse(root.dataset.states ?? '[]') as DemoState[];
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-state]');
    const shots = root.querySelectorAll<HTMLElement>('[data-shot]');
    const title = root.querySelector<HTMLElement>('[data-title]')!;
    const note = root.querySelector<HTMLElement>('[data-note]')!;

    const choose = (id: string) => {
      const s = states.find((x) => x.id === id);
      if (!s) return;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.state === id)));
      shots.forEach((img) => (img.hidden = img.dataset.shot !== id));
      title.textContent = s.title;
      note.textContent = s.note;
    };

    buttons.forEach((b) => b.addEventListener('click', () => choose(b.dataset.state!)));
  }
</script>
